					<!-- =================================================================
     DIGIEXE — animated analytics GRAPH (right column only)
     Pure CSS. No JS, no libraries. Transparent background.
     Self-drawing area chart + dot traveling the curve (motion path)
     + count-up badge + peak tooltip + sheen. Namespaced .dx2-*
     ================================================================= -->
<style>
  .dx2-wrap {
    --ink:#1B1A18; --muted:#6B6760; --amber:#F5A524; --orange:#F26B2A;
    --red:#E8412E; --green:#1E9E5A; --card:#FFFFFF;
    box-sizing:border-box; width:100%; display:flex; justify-content:center;
    /* Optional: uncomment to force-load Inter from Google Fonts
       @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap'); */
    font-family:"Inter","Segoe UI",system-ui,-apple-system,Roboto,"Helvetica Neue",Arial,sans-serif;
    -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
  }
  .dx2-wrap *,.dx2-wrap *::before,.dx2-wrap *::after{ box-sizing:border-box; }

  .dx2-stage{ position:relative; width:420px; max-width:100%; padding:14px;
    animation:dx2Float 6.5s ease-in-out infinite; }

  /* ambient glow behind card */
  .dx2-glow{ position:absolute; inset:30px 8px 8px; border-radius:30px; z-index:0;
    background:radial-gradient(60% 60% at 70% 30%, rgba(245,165,36,.35), transparent 70%);
    filter:blur(26px); animation:dx2Pulse 7s ease-in-out infinite; }

  .dx2-card{ position:relative; z-index:1; background:var(--card); border-radius:24px;
    padding:24px 24px 18px; overflow:hidden;
    box-shadow:0 30px 70px rgba(120,90,30,.18); border:1px solid rgba(0,0,0,.03);
    animation:dx2In 1s cubic-bezier(.2,.8,.2,1) both; }
  /* moving sheen */
  .dx2-card::after{ content:""; position:absolute; inset:0; pointer-events:none;
    background:linear-gradient(110deg,transparent 35%,rgba(255,255,255,.55) 50%,transparent 65%);
    transform:translateX(-130%); animation:dx2Sheen 5.5s ease-in-out 1.6s infinite; }

  /* header */
  .dx2-head{ display:flex; align-items:center; gap:9px; }
  .dx2-title{ font-size:14px; font-weight:600; color:var(--muted); }
  .dx2-live{ width:8px; height:8px; border-radius:50%; background:var(--green); position:relative; }
  .dx2-live::before{ content:""; position:absolute; inset:-4px; border-radius:50%;
    background:var(--green); opacity:.35; animation:dx2Live 1.8s ease-out infinite; }
  .dx2-spacer{ flex:1; }
  .dx2-pill{ font-size:12px; font-weight:800; color:var(--green); background:#E2F5EA;
    padding:5px 10px; border-radius:999px;
    animation:dx2Pop .6s ease-out 1.6s both, dx2Beat 2.8s ease-in-out 2.2s infinite; }
  .dx2-pill::after{ content:"+" counter(g) "%"; counter-reset:g var(--g); }
  .dx2-pill{ --g:0; animation-name:dx2Pop,dx2Beat,dx2Count; }

  .dx2-value{ margin:8px 0 14px; font-size:40px; font-weight:800; color:var(--ink);
    letter-spacing:-.01em; clip-path:inset(0 100% 0 0);
    animation:dx2Reveal 1s cubic-bezier(.2,.8,.2,1) .5s forwards; }
  .dx2-value span{ font-size:15px; font-weight:600; color:var(--muted); margin-left:8px; }

  /* chart (fixed coord box so the motion-path dot lines up exactly) */
  .dx2-chart{ position:relative; width:372px; max-width:100%; height:196px; }
  .dx2-chart svg{ position:absolute; inset:0; width:100%; height:100%; overflow:visible; }

  .dx2-grid line{ stroke:#EFEAdf; stroke:#EEE8DA; stroke-width:1; stroke-dasharray:4 5;
    opacity:0; animation:dx2Fade .6s ease-out forwards; }
  .dx2-grid line:nth-child(1){ animation-delay:.2s; }
  .dx2-grid line:nth-child(2){ animation-delay:.3s; }
  .dx2-grid line:nth-child(3){ animation-delay:.4s; }
  .dx2-grid line:nth-child(4){ animation-delay:.5s; }

  .dx2-area{ opacity:0; animation:dx2AreaIn 1.4s ease-out .6s forwards; }
  .dx2-line{ fill:none; stroke:url(#dx2Stroke); stroke-width:4; stroke-linecap:round;
    stroke-linejoin:round; stroke-dasharray:100;
    animation:dx2Draw 1.8s cubic-bezier(.4,0,.2,1) .55s forwards; }

  .dx2-xlabels{ position:absolute; left:0; right:0; bottom:-4px; display:flex;
    justify-content:space-between; padding:0 4px; }
  .dx2-xlabels span{ font-size:11px; color:#A8A296; opacity:0; animation:dx2Fade .5s ease-out forwards; }
  .dx2-xlabels span:nth-child(1){ animation-delay:1.4s; }
  .dx2-xlabels span:nth-child(2){ animation-delay:1.5s; }
  .dx2-xlabels span:nth-child(3){ animation-delay:1.6s; }
  .dx2-xlabels span:nth-child(4){ animation-delay:1.7s; }
  .dx2-xlabels span:nth-child(5){ animation-delay:1.8s; }
  .dx2-xlabels span:nth-child(6){ animation-delay:1.9s; }

  /* the glowing dot that travels the curve */
  .dx2-dot{ position:absolute; top:0; left:0; width:16px; height:16px; border-radius:50%;
    background:var(--orange); box-shadow:0 0 0 4px rgba(242,107,42,.18), 0 6px 14px rgba(242,107,42,.5);
    offset-anchor:50% 50%; offset-rotate:0deg;
    offset-path:path("M16 150 C55 140 80 112 120 120 S180 86 220 96 S300 44 344 34");
    offset-distance:0%; animation:dx2Travel 4.2s ease-in-out 2.4s infinite; }
  .dx2-dot::before{ content:""; position:absolute; inset:-3px; border-radius:50%;
    border:2px solid rgba(242,107,42,.5); animation:dx2Ring 1.6s ease-out infinite; }

  /* peak tooltip */
  .dx2-tip{ position:absolute; left:268px; top:-6px; background:var(--ink); color:#fff;
    font-size:12px; font-weight:700; padding:6px 10px; border-radius:9px; white-space:nowrap;
    opacity:0; transform:translateY(6px) scale(.8);
    animation:dx2Pop .6s cubic-bezier(.2,1.2,.4,1) 2.1s forwards, dx2Bob 3.4s ease-in-out 2.7s infinite; }
  .dx2-tip::after{ content:""; position:absolute; left:18px; bottom:-5px; width:10px; height:10px;
    background:var(--ink); transform:rotate(45deg); border-radius:2px; }

  /* ---------- keyframes ---------- */
  @property --g{ syntax:'<integer>'; initial-value:0; inherits:false; }

  @keyframes dx2In{ from{ opacity:0; transform:translateY(20px); } to{ opacity:1; transform:translateY(0); } }
  @keyframes dx2Float{ 0%,100%{ transform:translateY(0); } 50%{ transform:translateY(-12px); } }
  @keyframes dx2Pulse{ 0%,100%{ opacity:.55; } 50%{ opacity:.9; } }
  @keyframes dx2Sheen{ 0%{ transform:translateX(-130%); } 55%,100%{ transform:translateX(130%); } }
  @keyframes dx2Live{ 0%{ transform:scale(.7); opacity:.5; } 100%{ transform:scale(2.4); opacity:0; } }
  @keyframes dx2Pop{ from{ opacity:0; transform:scale(.6); } to{ opacity:1; transform:scale(1); } }
  @keyframes dx2Beat{ 0%,100%{ transform:scale(1); } 50%{ transform:scale(1.08); } }
  @keyframes dx2Count{ to{ --g:128; } }
  @keyframes dx2Reveal{ to{ clip-path:inset(0 0 0 0); } }
  @keyframes dx2Fade{ to{ opacity:1; } }
  @keyframes dx2AreaIn{ from{ opacity:0; } to{ opacity:1; } }
  @keyframes dx2Draw{ to{ stroke-dashoffset:0; } }
  @keyframes dx2Travel{ 0%{ offset-distance:0%; opacity:0; } 8%{ opacity:1; }
    90%{ opacity:1; } 100%{ offset-distance:100%; opacity:0; } }
  @keyframes dx2Ring{ 0%{ transform:scale(.8); opacity:.8; } 100%{ transform:scale(1.9); opacity:0; } }
  @keyframes dx2Bob{ 0%,100%{ transform:translateY(0) scale(1); } 50%{ transform:translateY(-4px) scale(1); } }

  /* the line uses pathLength=100 so dasharray:100 == full length */
  .dx2-line{ stroke-dashoffset:100; }

  /* ---------- responsive ---------- */
  @media (max-width:520px){ .dx2-stage{ transform:scale(.84); transform-origin:top center; } }

  /* ---------- accessibility ---------- */
  @media (prefers-reduced-motion:reduce){
    .dx2-wrap *{ animation:none !important; }
    .dx2-value{ clip-path:inset(0 0 0 0); }
    .dx2-line{ stroke-dashoffset:0; }
    .dx2-area,.dx2-grid line,.dx2-xlabels span,.dx2-pill,.dx2-tip{ opacity:1; }
    .dx2-tip{ transform:none; }
    .dx2-pill{ --g:128; }
    .dx2-dot{ offset-distance:100%; opacity:1; }
  }
</style>

